{
  "name": "sc-gis-layer-views",
  "label": "Layer-Themen",
  "type": "widget",
  "version": "0.8.1",
  "exbVersion": "1.17.0",
  "author": "SC-GIS",
  "description": "Vordefinierte Layer-Themen für eine verknüpfte WebMap.",
  "dependency": [
    "jimu-arcgis"
  ],
  "translatedLocales": [
    "en",
    "de",
    "fr"
  ],
  "defaultSize": {
    "width": 580,
    "height": 380
  },
  "properties": {
    "hasConfig": true
  },
  "settingDependency": [
    "jimu-arcgis"
  ],
  "extensions": [
    {
      "point": "APP_CONFIG_PROCESSOR_EXTENSION",
      "uri": "extensions/theme-startup"
    }
  ]
}
